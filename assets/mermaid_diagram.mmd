flowchart TB
    %% =========================
    %% WAN / Internet
    %% =========================

    VPN["VPN Client"]
    INTERNET(("Internet"))
    MODEM["ISP Modem"]
    ROUTER["UniFi Router"]

    VPN -->|VPN Tunnel| INTERNET
    INTERNET --> MODEM
    MODEM --> ROUTER


    %% =========================
    %% Security / Camera Network
    %% =========================

    FIREWALL["Firewall"]

    subgraph VLAN40["VLAN40 - Cameras"]
        CAMERA["Security Camera 1.3"]
        NVR2["NAS/NVR NIC2"]
        CAMERA --> NVR2
    end

    ROUTER --> FIREWALL
    FIREWALL --> CAMERA
    FIREWALL --> NVR2


    %% =========================
    %% Personal Devices
    %% =========================

    subgraph VLAN1["VLAN1 - Personal Devices"]
        LAPTOP["Personal Laptop"]
        PHONE["Personal Smartphone 1..3"]
    end

    ROUTER --> VLAN1


    %% =========================
    %% Guest Network
    %% =========================

    subgraph VLAN20["VLAN20 - Guests"]
        WORKLAPTOP["Work Laptop"]
        WORKPHONE["Work Smartphone"]
        GUEST["Guest Device 1..n"]
        PS5["PlayStation 5"]
    end

    ROUTER --> VLAN20


    %% =========================
    %% IoT Network
    %% =========================

    subgraph VLAN30["VLAN30 - IoT"]
        HUB["Smart Hub 1..2"]
        TV["Smart TV 1..2"]
        DOORBELL["Smart Doorbell"]
        VACUUM["Robot Vacuum"]
        BULB["Smart Bulb 1..n"]
        PLUG["Smart Plug 1..n"]
        AIRTHINGS["Airthings Wave Plus"]
    end

    ROUTER --> VLAN30

    HUB --- TV
    HUB --- DOORBELL
    HUB --- VACUUM
    HUB --- BULB
    HUB --- PLUG
    HUB --- AIRTHINGS


    %% =========================
    %% Home Lab
    %% =========================

    subgraph VLAN50["VLAN50 - Home Lab"]
        LABLAPTOP["Personal Dev Laptop"]
        PROXMOX["Proxmox VE 1..n"]
        HA["Home Assistant"]
        UBUNTU["Ubuntu"]
        VM["VM 1..n"]
    end

    ROUTER --> VLAN50

    LABLAPTOP --> PROXMOX
    PROXMOX --> HA
    PROXMOX --> UBUNTU
    PROXMOX --> VM


    %% =========================
    %% Storage
    %% =========================

    NVR1["NAS/NVR NIC1"]

    FIREWALL --> NVR1
    NVR1 --> PROXMOX


    %% =========================
    %% Styling
    %% =========================

    classDef network fill:#111,color:#fff,stroke:#555
    classDef device fill:#f5f5f5,color:#111,stroke:#333
    classDef vlan fill:#fafafa,color:#111,stroke:#777,stroke-dasharray:5 5

    class INTERNET,MODEM,ROUTER,FIREWALL,NVR1,NVR2 network
    class VPN,LAPTOP,PHONE,WORKLAPTOP,WORKPHONE,GUEST,PS5,HUB,TV,DOORBELL,VACUUM,BULB,PLUG,AIRTHINGS,LABLAPTOP,PROXMOX,HA,UBUNTU,VM,CAMERA device
